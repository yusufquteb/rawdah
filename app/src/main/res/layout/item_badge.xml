<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center"
    android:padding="12dp" android:layout_margin="4dp"
    android:background="@drawable/bg_card_rounded"
    android:elevation="2dp">

    <FrameLayout android:layout_width="72dp" android:layout_height="72dp">
        <TextView android:id="@+id/iv_badge_icon"
            android:layout_width="72dp" android:layout_height="72dp"
            android:gravity="center" android:textSize="40sp"/>
        <View android:id="@+id/lock_overlay"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#80FFFFFF" android:visibility="gone"/>
        <TextView android:id="@+id/tv_lock_icon"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="🔒"
            android:textSize="24sp" android:visibility="gone"/>
    </FrameLayout>

    <TextView android:id="@+id/tv_badge_name"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:fontFamily="@font/cairo"
        android:textStyle="bold" android:textColor="@color/text_primary"
        android:gravity="center" android:layout_marginTop="6dp"
        android:maxLines="2" android:ellipsize="end"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/bstar1" android:layout_width="16dp"
            android:layout_height="16dp" android:src="@drawable/ic_star_empty"
            android:scaleType="fitCenter" android:contentDescription="@null"/>
        <ImageView android:id="@+id/bstar2" android:layout_width="16dp"
            android:layout_height="16dp" android:src="@drawable/ic_star_empty"
            android:scaleType="fitCenter" android:contentDescription="@null"
            android:layout_marginHorizontal="2dp"/>
        <ImageView android:id="@+id/bstar3" android:layout_width="16dp"
            android:layout_height="16dp" android:src="@drawable/ic_star_empty"
            android:scaleType="fitCenter" android:contentDescription="@null"/>
    </LinearLayout>
</LinearLayout>
