<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:background="@color/bg_cream">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_vertical" android:paddingHorizontal="12dp"
            android:orientation="horizontal">
            <ImageView android:id="@+id/btn_back" android:layout_width="40dp"
                android:layout_height="40dp" android:padding="8dp"
                android:src="@drawable/back" android:tint="#FFFFFF"
                android:scaleType="fitCenter" android:contentDescription="@null"/>
            <TextView android:id="@+id/tv_header_letter"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="22sp"
                android:fontFamily="@font/cairo" android:textStyle="bold"
                android:textColor="#FFFFFF" android:gravity="center"/>
            <ImageView android:id="@+id/iv_mascot" android:layout_width="44dp"
                android:layout_height="44dp" android:src="@drawable/mascot_boy"
                android:scaleType="fitCenter" android:contentDescription="@null"/>
        </LinearLayout>

        <!-- Letter name + instruction -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="16dp" android:paddingVertical="8dp">
            <TextView android:id="@+id/tv_letter_name"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp" android:fontFamily="@font/cairo"
                android:textStyle="bold" android:textColor="@color/text_primary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/writing_instruction"
                android:textSize="14sp" android:fontFamily="@font/cairo"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <!-- Tracing canvas -->
        <myfirstwords.mynationdreams.LetterTracingView
            android:id="@+id/tracing_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="12dp"
            android:background="@drawable/bg_card_rounded"
            android:elevation="4dp"/>

        <!-- Action buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="12dp">
            <TextView android:id="@+id/btn_clear"
                android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_orange"
                android:text="@string/writing_clear"
                android:textSize="15sp" android:fontFamily="@font/cairo"
                android:textStyle="bold" android:textColor="#FFFFFF"
                android:gravity="center"/>
            <TextView android:id="@+id/btn_check"
                android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_green"
                android:text="@string/writing_check"
                android:textSize="15sp" android:fontFamily="@font/cairo"
                android:textStyle="bold" android:textColor="#FFFFFF"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Feedback -->
        <TextView android:id="@+id/tv_feedback"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="20sp" android:fontFamily="@font/cairo"
            android:textStyle="bold" android:gravity="center"
            android:paddingBottom="12dp"/>
    </LinearLayout>

    <!-- Navigation arrows -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="4dp">
        <TextView android:id="@+id/btn_prev"
            android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_circle_primary"
            android:text="›" android:textSize="24sp"
            android:textColor="#FFFFFF" android:gravity="center"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/btn_next"
            android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_circle_primary"
            android:text="‹" android:textSize="24sp"
            android:textColor="#FFFFFF" android:gravity="center"/>
    </LinearLayout>

    <myfirstwords.mynationdreams.ConfettiView android:id="@+id/confetti"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clickable="false"/>
</FrameLayout>
