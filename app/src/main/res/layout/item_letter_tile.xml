<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="80dp"
    android:orientation="vertical" android:gravity="center"
    android:layout_margin="4dp" android:background="@drawable/bg_card_rounded"
    android:elevation="2dp">

    <TextView android:id="@+id/tv_letter"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="28sp" android:fontFamily="@font/cairo"
        android:textStyle="bold" android:textColor="@color/primary_purple"/>

    <TextView android:id="@+id/tv_letter_name"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:fontFamily="@font/cairo"
        android:textColor="@color/text_secondary" android:layout_marginTop="2dp"/>
</LinearLayout>
