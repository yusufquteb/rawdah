<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/bg_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="16dp">

            <!-- Main card -->
            <LinearLayout
                android:id="@+id/box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:padding="16dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:elevation="4dp">

                <!-- Counter chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_counter_chip"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="5dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/textview2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 / 4"
                        android:textSize="14sp"
                        android:fontFamily="@font/cairo"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary" />
                </LinearLayout>

                <!-- Word image -->
                <LinearLayout
                    android:id="@+id/lin_pic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="240dp"
                        android:layout_height="240dp">

                        <ImageView
                            android:id="@+id/imageview1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/default_image"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Arabic word -->
                <LinearLayout
                    android:id="@+id/linear2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_word_ar"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="8dp">

                    <TextView
                        android:id="@+id/textview1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الكلمة"
                        android:textSize="28sp"
                        android:fontFamily="@font/cairo"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center" />
                </LinearLayout>

                <!-- English word -->
                <LinearLayout
                    android:id="@+id/linear3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/textview4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Word"
                        android:textSize="18sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/text_secondary"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Song lyric (shown only for alphabet) -->
                <LinearLayout
                    android:id="@+id/layout_song_lyric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:background="@drawable/bg_lyric_card"
                    android:padding="12dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵 كلمة الأغنية"
                        android:textSize="11sp"
                        android:fontFamily="@font/cairo"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_song_lyric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="16sp"
                        android:fontFamily="@font/cairo"
                        android:textStyle="italic"
                        android:textColor="@color/text_primary"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Animal image for alphabet (shown only for alphabet) -->
                <LinearLayout
                    android:id="@+id/layout_animal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الحيوان:"
                        android:textSize="12sp"
                        android:fontFamily="@font/cairo"
                        android:textColor="@color/text_secondary" />

                    <ImageView
                        android:id="@+id/iv_animal"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tv_animal_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="15sp"
                        android:fontFamily="@font/cairo"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Sound buttons row -->
                <LinearLayout
                    android:id="@+id/linear8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <!-- Listen Arabic -->
                    <LinearLayout
                        android:id="@+id/btn_play_ar"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_button_primary"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sound"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="عربي"
                            android:fontFamily="@font/cairo"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                    <!-- Listen English -->
                    <LinearLayout
                        android:id="@+id/btn_play_en"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_button_en"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="20dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sound"
                            android:contentDescription="@null" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="English"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                    <!-- Animal sound (shown for animals + alphabet) -->
                    <LinearLayout
                        android:id="@+id/play"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_button_orange"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🐾"
                            android:textSize="18sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="صوت"
                            android:fontFamily="@font/cairo"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Encouragement message -->
                <TextView
                    android:id="@+id/tv_encouragement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textSize="16sp"
                    android:fontFamily="@font/cairo"
                    android:textColor="@color/success_green"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Confetti overlay (invisible until triggered) -->
    <myfirstwords.mynationdreams.ConfettiView
        android:id="@+id/confetti_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false" />

</FrameLayout>
